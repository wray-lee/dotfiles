#!/usr/bin/env bash
# Linux (Wayland/niri) computer-use helper: screenshot + synthetic input.
# Coordinates are always logical pixels of the focused output, i.e. exactly what `shot` produces.
set -euo pipefail

export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket}"
OUT_DIR="${CU_DIR:-/tmp/cu}"; mkdir -p "$OUT_DIR"
HDR=/usr/include/linux/input-event-codes.h

die() { echo "cu: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing command: $1"; }

# prints "name width height" of the focused output (logical size)
focused() {
  niri msg -j focused-output | jq -r '"\(.name) \(.logical.width) \(.logical.height) \(.logical.x) \(.logical.y)"'
}

keycode() { # name -> linux key code
  local n="${1,,}"
  case "$n" in
    ctrl) n=leftctrl;; shift) n=leftshift;; alt) n=leftalt;; super|meta|win) n=leftmeta;;
    enter|return) n=enter;; esc|escape) n=esc;; del) n=delete;; pgup) n=pageup;; pgdn) n=pagedown;;
  esac
  local v
  v=$(grep -E "^#define KEY_${n^^}[[:space:]]" "$HDR" | awk '{print $3}' | head -n1)
  [ -n "$v" ] || die "unknown key: $1"
  echo $((v))
}

press() { # "ctrl+shift+t" -> down in order, up in reverse
  local codes=() down=() up=() k c
  IFS='+' read -ra parts <<<"$1"
  for k in "${parts[@]}"; do codes+=("$(keycode "$k")"); done
  for c in "${codes[@]}"; do down+=("$c:1"); done
  for ((i=${#codes[@]}-1; i>=0; i--)); do up+=("${codes[i]}:0"); done
  ydotool key "${down[@]}" "${up[@]}"
}

FIFO="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cu-pointer.fifo"
SELF_DIR="$(dirname "$(readlink -f "$0")")"

# send one line to the pointer daemon, starting it on first use
ptr() {
  if ! { [ -p "$FIFO" ] && pgrep -u "$(id -u)" -f "pointer.py $FIFO" >/dev/null; }; then
    rm -f "$FIFO"; mkfifo "$FIFO"
    setsid python3 -I "$SELF_DIR/pointer.py" "$FIFO" >"$OUT_DIR/pointer.log" 2>&1 </dev/null &
    sleep 1.5
  fi
  echo "$*" >"$FIFO"
}

moveto() { # x y in logical px -> 0..32767 absolute axis
  local x=$1 y=$2 name w h
  # shortcut: single-output only (device maps onto the first output), extend when a second monitor is used
  read -r name w h _ <<<"$(focused)"
  ptr m $(( x * 32767 / (w - 1) )) $(( y * 32767 / (h - 1) ))
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  doctor)
    rc=0
    for c in grim ydotool wl-copy niri jq; do command -v $c >/dev/null && echo "ok   $c" || { echo "FAIL $c not installed"; rc=1; }; done
    [ -r "$HDR" ] && echo "ok   $HDR" || { echo "FAIL $HDR missing (key names)"; rc=1; }
    [ -w /dev/uinput ] && echo "ok   /dev/uinput writable" || { echo "FAIL /dev/uinput not writable: add user to group 'input' and re-login"; rc=1; }
    [ -S "$YDOTOOL_SOCKET" ] && echo "ok   ydotoold socket $YDOTOOL_SOCKET" || { echo "FAIL ydotoold not running: systemctl --user enable --now ydotool"; rc=1; }
    echo "focused output: $(focused)"
    exit $rc;;
  shot) # cu shot [path]  -> prints file path; open it with the Read tool
    need grim; mkdir -p "$OUT_DIR"
    f="${1:-$OUT_DIR/shot-$(date +%H%M%S).png}"
    read -r name _ <<<"$(focused)"
    grim -s 1 -c -o "$name" "$f"   # -s 1: logical pixels; -c: draw cursor so you can see where it is
    echo "$f";;
  move)  moveto "$1" "$2";;
  click) # cu click x y [left|right|middle|double]
    moveto "$1" "$2"; sleep 0.05
    case "${3:-left}" in
      left) ptr d 272; ptr u 272;; right) ptr d 273; ptr u 273;; middle) ptr d 274; ptr u 274;;
      double) ptr d 272; ptr u 272; sleep 0.08; ptr d 272; ptr u 272;;
      *) die "button: left|right|middle|double";;
    esac;;
  drag) # cu drag x1 y1 x2 y2
    moveto "$1" "$2"; sleep 0.05; ptr d 272; sleep 0.1
    moveto "$3" "$4"; sleep 0.1; ptr u 272;;
  scroll) # cu scroll up|down [notches]
    n="${2:-3}"; [ "$1" = up ] && d=1 || d=-1
    ptr w $((d * n));;
  type) # paste via clipboard: works for any language; terminals need `cu key ctrl+shift+v` instead
    need wl-copy; prev=$(wl-paste -n 2>/dev/null || true)
    printf '%s' "$1" | wl-copy
    sleep 0.05; press "${2:-ctrl+v}"; sleep 0.15
    printf '%s' "$prev" | wl-copy;;
  key) press "$1";;
  windows) niri msg -j windows | jq -r '.[] | "\(.id)\t\(if .is_focused then "*" else " " end)\t\(.app_id)\t\(.title)"';;
  focus)   niri msg action focus-window --id "$1";;
  calibrate) # park pointer at screen centre, screenshot with cursor; check the cursor is really in the middle
    read -r _ w h _ <<<"$(focused)"; moveto $((w/2)) $((h/2)); sleep 0.2; "$0" shot;;
  *)
    cat <<EOF
cu doctor | shot [path] | move x y | click x y [left|right|middle|double] | drag x1 y1 x2 y2
   | scroll up|down [n] | type "text" [paste-combo] | key ctrl+shift+t | windows | focus ID | calibrate
EOF
    ;;
esac
