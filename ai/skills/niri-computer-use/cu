#!/usr/bin/env bash
# Linux (Wayland/niri) computer-use helper: screenshot + synthetic input.
# Coordinates are always logical pixels of the focused output, i.e. exactly what `shot` produces.
set -euo pipefail

RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; export XDG_RUNTIME_DIR="$RT"
export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-$RT/.ydotool_socket}"
OUT_DIR="${CU_DIR:-$RT/cu}"; mkdir -p -m 700 "$OUT_DIR"   # private: screenshots can show secrets
HDR=/usr/include/linux/input-event-codes.h
FIFO="$RT/cu-pointer.fifo"
SELF_DIR="$(dirname "$(readlink -f "$0")")"

die() { echo "cu: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing command: $1"; }
nargs() { [ "$1" -ge "$2" ] || die "usage: $3"; }   # nargs $# MIN "usage"
num() { local a; for a; do [[ $a =~ ^[0-9]+$ ]] || die "not a non-negative integer: '$a'"; done; }

# ssh and cron shells have no compositor env: find niri's socket
if [ -z "${NIRI_SOCKET:-}" ]; then
  NIRI_SOCKET=$(ls -t "$RT"/niri.*.sock 2>/dev/null | head -n1 || true)
  [ -n "$NIRI_SOCKET" ] && export NIRI_SOCKET
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  WAYLAND_DISPLAY=$(ls "$RT" 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -n1 || true)
  [ -n "$WAYLAND_DISPLAY" ] && export WAYLAND_DISPLAY
fi

# "name logical_w logical_h layout_x layout_y" of the focused output (niri reports logical size, rotation applied)
focused() {
  niri msg -j focused-output | jq -er '"\(.name) \(.logical.width) \(.logical.height) \(.logical.x) \(.logical.y)"'
}

# sets globals name w h ox oy, or dies: never compute coordinates from a failed query
geom() {
  local f
  f=$(focused) || die "cannot query niri (NIRI_SOCKET=${NIRI_SOCKET:-unset})"
  read -r name w h ox oy <<<"$f"
  [[ ${w:-} =~ ^[0-9]+$ && ${h:-} =~ ^[0-9]+$ ]] && (( w > 1 && h > 1 )) || die "bad output geometry: '$f'"
}

check() { num "$1" "$2"; geom; (( $1 < w && $2 < h )) || die "($1,$2) is outside the ${w}x${h} screen"; }

keycode() { # name -> linux key code; accepts enter, leftctrl, KEY_A, and the aliases below
  local n="${1,,}" v
  n="${n#key_}"
  case "$n" in
    ctrl) n=leftctrl;; shift) n=leftshift;; alt) n=leftalt;; super|meta|win) n=leftmeta;;
    return) n=enter;; escape) n=esc;; del) n=delete;; pgup) n=pageup;; pgdn) n=pagedown;;
  esac
  v=$(awk -v k="KEY_${n^^}" '$1=="#define" && $2==k {print $3; exit}' "$HDR")
  # a few KEY_ names are defined as another KEY_ name
  [[ $v == KEY_* ]] && v=$(awk -v k="$v" '$1=="#define" && $2==k {print $3; exit}' "$HDR")
  [[ $v =~ ^(0x[0-9a-fA-F]+|[0-9]+)$ ]] || die "unknown key: $1"
  echo $((v))
}

press() { # "ctrl+shift+t" -> down in order, up in reverse
  local codes=() down=() up=() k c i
  IFS='+' read -ra parts <<<"$1"
  for k in "${parts[@]}"; do c=$(keycode "$k") || exit 1; codes+=("$c"); done
  for c in "${codes[@]}"; do down+=("$c:1"); done
  for ((i=${#codes[@]}-1; i>=0; i--)); do up+=("${codes[i]}:0"); done
  ydotool key "${down[@]}" "${up[@]}"
}

# pointer.log is written when the daemon starts, so a newer pointer.py means the running one is stale
# the daemon is tracked by pid file (pkill -f would also hit any shell whose command line mentions the FIFO)
PIDF="$FIFO.pid"
dpid() { local p; p=$(cat "$PIDF" 2>/dev/null) && grep -qa pointer.py "/proc/$p/cmdline" 2>/dev/null && echo "$p"; }
daemon_up() { [ -p "$FIFO" ] && [ ! "$SELF_DIR/pointer.py" -nt "$OUT_DIR/pointer.log" ] && dpid >/dev/null; }
stop_daemon() { local p; if p=$(dpid); then kill "$p"; sleep 0.3; fi; rm -f "$PIDF" "$FIFO"; [ -n "${p:-}" ]; }

# send one line to the pointer daemon, starting it on first use
ptr() {
  if ! daemon_up; then
    exec 9>"$FIFO.lock"; flock -w 10 9 || die "pointer daemon lock is busy"
    if ! daemon_up; then   # re-check under the lock: another cu may have just started it
      stop_daemon || true   # stale daemon, or one whose FIFO is gone
      mkfifo -m 600 "$FIFO"
      setsid python3 -I "$SELF_DIR/pointer.py" "$FIFO" >"$OUT_DIR/pointer.log" 2>&1 </dev/null 9>&- &
      echo $! >"$PIDF"
      local i; for i in $(seq 50); do grep -qx ready "$OUT_DIR/pointer.log" && break; sleep 0.1; done
      grep -qx ready "$OUT_DIR/pointer.log" || die "pointer daemon did not start: $(cat "$OUT_DIR/pointer.log")"
    fi
    exec 9>&-
  fi
  # timeout: opening a FIFO that has no reader blocks forever
  printf '%s\n' "$*" | timeout 3 tee "$FIFO" >/dev/null \
    || die "pointer daemon is not reading $FIFO: $(tail -n 3 "$OUT_DIR/pointer.log")"
}

moveto() { # x y in logical px of the focused output -> 0..32767 absolute axis
  check "$1" "$2"
  # shortcut: single-output only (device maps onto the first output), extend when a second monitor is used
  ptr m $(( $1 * 32767 / (w - 1) )) $(( $2 * 32767 / (h - 1) ))
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  doctor)
    rc=0
    for c in grim ydotool wl-copy wl-paste niri jq python3 flock timeout; do
      command -v $c >/dev/null && echo "ok   $c" || { echo "FAIL $c not installed"; rc=1; }; done
    [ -r "$HDR" ] && echo "ok   $HDR" || { echo "FAIL $HDR missing (key names)"; rc=1; }
    [ -w /dev/uinput ] && echo "ok   /dev/uinput writable" || { echo "FAIL /dev/uinput not writable: add user to group 'input' and re-login"; rc=1; }
    [ -S "$YDOTOOL_SOCKET" ] && echo "ok   ydotoold socket $YDOTOOL_SOCKET (keyboard)" || { echo "FAIL ydotoold not running: systemctl --user enable --now ydotool"; rc=1; }
    if (geom); then echo "ok   niri, focused output: $(focused)"
    else echo "FAIL cannot talk to niri"; rc=1; fi
    exit $rc;;
  shot) # cu shot [path]  -> prints file path; open it with the Read tool
    need grim; geom
    f="${1:-$OUT_DIR/shot-$(date +%H%M%S%3N).png}"
    # -s 1: logical pixels; -c: draw cursor (terminals often hide it)
    timeout 15 grim -s 1 -c -o "$name" "$f" || die "grim failed or timed out"
    echo "$f";;
  move)  nargs $# 2 "cu move x y"; moveto "$1" "$2";;
  click) # cu click x y [left|right|middle|double]
    nargs $# 2 "cu click x y [left|right|middle|double]"
    case "${3:-left}" in left|double) b=272;; right) b=273;; middle) b=274;; *) die "button: left|right|middle|double";; esac
    moveto "$1" "$2"; sleep 0.05
    ptr d $b; ptr u $b
    if [ "${3:-}" = double ]; then sleep 0.08; ptr d $b; ptr u $b; fi;;
  drag) # cu drag x1 y1 x2 y2
    nargs $# 4 "cu drag x1 y1 x2 y2"; check "$3" "$4"   # validate the end point before pressing
    moveto "$1" "$2"; sleep 0.05
    trap 'ptr u 272' EXIT   # never leave the button held if anything below fails
    ptr d 272; sleep 0.1; moveto "$3" "$4"; sleep 0.1; ptr u 272
    trap - EXIT;;
  scroll) # cu scroll up|down [notches]
    nargs $# 1 "cu scroll up|down [notches]"; n="${2:-3}"; num "$n"
    case "$1" in up) d=1;; down) d=-1;; *) die "scroll: up|down";; esac
    ptr w $((d * n));;
  type) # paste via clipboard (any language); terminals need: cu type "text" ctrl+shift+v
    nargs $# 1 'cu type "text" [paste-combo]'; need wl-copy; need wl-paste
    combo="${2:-ctrl+v}"; IFS='+' read -ra ks <<<"$combo"; for k in "${ks[@]}"; do keycode "$k" >/dev/null; done
    # save the current clipboard (text or binary, one mime type) and restore it even on failure
    saved="$OUT_DIR/clip.$$"; mime=""
    mapfile -t types < <(timeout 2 wl-paste --list-types 2>/dev/null || true)
    for t in "${types[@]}"; do [ "$t" = "text/plain;charset=utf-8" ] && mime=$t; done
    if [ -z "$mime" ] && [ ${#types[@]} -gt 0 ]; then mime=${types[0]}; fi
    if [ -n "$mime" ] && ! timeout 2 wl-paste -n --type "$mime" >"$saved"; then mime=""; fi
    trap 'if [ -n "$mime" ]; then wl-copy --type "$mime" <"$saved"; else wl-copy --clear; fi; rm -f "$saved"' EXIT
    printf '%s' "$1" | wl-copy
    sleep 0.05; press "$combo"
    sleep 0.5;;   # let slow apps read the clipboard before it is restored
  key) nargs $# 1 "cu key ctrl+shift+t"; press "$1";;
  windows) niri msg -j windows | jq -r '.[] | "\(.id)\t\(if .is_focused then "*" else " " end)\t\(.app_id)\t\(.title)"';;
  focus) nargs $# 1 "cu focus ID"; num "$1"; niri msg action focus-window --id "$1";;
  stop) # stop the pointer daemon (run after updating pointer.py)
    stop_daemon && echo "pointer daemon stopped" || echo "no pointer daemon running";;
  *)
    cat <<EOF
cu doctor | shot [path] | move x y | click x y [left|right|middle|double] | drag x1 y1 x2 y2
   | scroll up|down [n] | type "text" [paste-combo] | key ctrl+shift+t | windows | focus ID | stop
EOF
    ;;
esac
