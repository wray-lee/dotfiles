/* ---- niri twin of configs/[TOP] Default Laptop ---- */
// ### NIRI Laptop - Top ### //
{
"include": [
	"$HOME/.config/waybar/ModulesNiri",
	"$HOME/.config/waybar/ModulesNiriOverrides",
	"$HOME/.config/waybar/Modules",
	"$HOME/.config/waybar/ModulesCustom",
	"$HOME/.config/waybar/ModulesGroups",
	"$HOME/.config/waybar/UserModules",
	],
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 0,
"fixed-center": true,
"ipc": true,
"margin-top": 0,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"custom/separator#blank",
	"custom/cava_mviz",
	"custom/separator#blank",
	"custom/playerctl",
	"custom/separator#blank_2",
	"niri/window",
	"niri/workspaces",
	],

"modules-center": [
	"group/app_drawer",
	"custom/separator#blank",
	"group/notify",
	"custom/separator#dot-line",
	"clock",
	"custom/separator#dot-line",
	"custom/weather",
	"custom/separator#dot-line",
	"idle_inhibitor",
	"custom/hint",
	],

"modules-right": [
	"tray",
	"network#speed",
	"custom/separator#dot-line",
	"group/laptop",
	"custom/separator#dot-line",
	"group/mobo_drawer",
	"custom/separator#line",
	"group/audio",
	"custom/separator#dot-line",
	"custom/osk",
	"custom/separator#dot-line",
	"group/status_niri",
	],
"clock": {
	"format": "󰥔 {:%F %r %A}",
	"max-length": 100,
	"interval": 1,
	"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	"format-alt": "{:%Y-%m-%d}"
	},
}
