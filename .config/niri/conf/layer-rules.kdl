// conf/layer-rules.kdl
// ---------------------------------------------------------------------------
// ONE concern: layer-shell rules. Window rules live in conf/window-rules.kdl.
// Ported from ~/.config/hypr/hyprland.lua ("LAYER RULES" section).
//
// Hyprland applied `blur = true` to four namespaces. niri's equivalent is
// background-effect { blur true }. Namespaces are anchored so a bar called
// e.g. "waybar-extra" does not pick up the rule by accident.
// ---------------------------------------------------------------------------

// launcher
layer-rule {
    match namespace="^rofi$"
    background-effect {
        blur true
    }
}

// notification centre
layer-rule {
    match namespace="^swaync-control-center$"
    background-effect {
        blur true
    }
}

// notification popups: no blur. swaync's popup surface is a transparent strip
// as tall as the output, so niri's whole-rectangle blur (see the waybar note
// below) drew a blurred column down the middle of the screen.
layer-rule {
    match namespace="^swaync-notification-window$"
    background-effect {
        blur false
    }
}

// status bar: no blur. Hyprland's waybar-blur rule has ignore_alpha = 0, so the
// fully transparent gaps between modules stay clear there. niri blurs the whole
// layer rectangle (no alpha cutoff, and waybar sends no ext-background-effect
// shape), which fogs the gaps. Clear gaps matter more than blurred pills.
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur false
    }
}

// ===========================================================================
// Not portable to niri (kept here so nothing is silently dropped)
//
// From hyprland.lua LAYER RULES:
//   ignore_alpha = 0   No niri layer-rule property; no equivalent knob.
//                      niri blurs the surface as-is. There is no per-layer
//                      alpha cutoff to disable. For waybar this is why its
//                      blur is off (see the status bar rule above).
// ===========================================================================
